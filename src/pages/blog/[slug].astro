---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import '@waline/client/style';

export async function getStaticPaths() {
    const posts = await getCollection('blog');
    return posts.map(post => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const articlePath = `/blog/${post.slug}/`;
const articleUrl = new URL(articlePath, Astro.site ?? 'https://www.284868.xyz').toString();
const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.summary,
    datePublished: new Date(post.data.date).toISOString(),
    dateModified: new Date(post.data.date).toISOString(),
    url: articleUrl,
    mainEntityOfPage: articleUrl,
    author: {
        '@type': 'Person',
        name: '折腾狂人小绿',
    },
    publisher: {
        '@type': 'Organization',
        name: '老机复活',
        url: new URL('/', Astro.site ?? 'https://www.284868.xyz').toString(),
    },
    keywords: post.data.tags.join(', '),
    articleSection: post.data.categoryName,
};
---

<Layout title={`${post.data.title} | 老机复活`} description={post.data.summary} currentPath={articlePath} type="article" structuredData={structuredData}>
    <section id="post-detail-view" class="page-view">
        <div class="section-container article-view-container">
            <a href="/blog" class="back-link">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                返回文章列表
            </a>

            <article class="article-detail">
                <header class="article-header">
                    <div class="article-meta-top">
                        <span class="article-category-badge">{post.data.categoryName}</span>
                        <span class="article-date">{post.data.date}</span>
                    </div>
                    <h1 class="article-title-main">{post.data.title}</h1>
                    <div class="article-author-info">
                        <svg viewBox="0 0 40 40" class="mini-avatar">
                            <circle cx="20" cy="20" r="20" fill="var(--primary-light)" />
                            <rect x="12" y="10" width="16" height="12" rx="2" fill="var(--bg-card)" stroke="var(--primary-dark)" stroke-width="1.5"/>
                            <path d="M16,22 L13,29 L27,29 L24,22 Z" fill="var(--bg-card)" stroke="var(--primary-dark)" stroke-width="1.5" />
                        </svg>
                        <span class="author-name">折腾狂人小绿</span>
                        <span class="read-time-badge">📖 {post.data.readTime}</span>
                    </div>
                </header>

                <!-- Article Banner -->
                <div class="article-banner" style={`background: ${post.data.bannerGradient};`}>
                    <div class="banner-overlay-text">老机复活案例手记</div>
                </div>

                <!-- Article Content (rendered from Markdown) -->
                <div class="article-content markdown-body">
                    <Content />
                </div>

                <aside class="article-cta" aria-label="站内推荐">
                    <div>
                        <p class="article-cta-kicker">继续折腾</p>
                        <h2>想系统看完整套 Daphile、数播和反玄学实测？</h2>
                        <p>来老机复活独立站翻完整系列教程，也可以在评论区留下你的设备和预算，七木会尽量给你一个不烧钱的方案。</p>
                    </div>
                    <div class="article-cta-actions">
                        <a href="/blog" class="btn btn-primary">看完整系列</a>
                        <a href="/guestbook" class="btn btn-secondary">留下问题</a>
                    </div>
                </aside>

                <!-- Article Footer -->
                <footer class="article-footer">
                    <div class="article-tags">
                        {post.data.tags.map((tag: string) => (
                            <span class="tag-badge"># {tag}</span>
                        ))}
                    </div>
                    <div class="article-actions-row">
                        <button id="btn-like-post" class="action-btn-like" data-post-id={post.slug} data-base-likes={post.data.likes}>
                            <svg class="icon heart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                            </svg>
                            <span>赞 (<span id="detail-likes-count">{post.data.likes}</span>)</span>
                        </button>
                        <button id="btn-share-post" class="action-btn-share">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="18" cy="5" r="3"></circle>
                                <circle cx="6" cy="12" r="3"></circle>
                                <circle cx="18" cy="19" r="3"></circle>
                                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                            </svg>
                            <span>分享链接</span>
                        </button>
                    </div>
                </footer>
            </article>

            <!-- Waline Comments -->
            <div class="article-comments-section">
                <h3 class="comments-section-title">文章评论</h3>
                <div id="waline" data-path={`/blog/${post.slug}`} data-title={post.data.title}></div>
            </div>
        </div>
    </section>
</Layout>

<script>
import { init } from '@waline/client';

function initPostDetail() {
    const btnLike = document.getElementById('btn-like-post');
    const likesCountEl = document.getElementById('detail-likes-count');
    if (!btnLike || !likesCountEl) return;

    const postId = btnLike.getAttribute('data-post-id') || '';
    const baseLikes = parseInt(btnLike.getAttribute('data-base-likes') || '0');

    // Check localStorage for existing like
    const likes = JSON.parse(localStorage.getItem('omr_likes') || '{}');
    if (likes[postId]) {
        btnLike.classList.add('liked');
        likesCountEl.innerText = String(baseLikes + 1);
    }

    btnLike.addEventListener('click', () => {
        const liked = btnLike.classList.toggle('liked');
        const allLikes = JSON.parse(localStorage.getItem('omr_likes') || '{}');
        if (liked) {
            allLikes[postId] = true;
            likesCountEl.innerText = String(baseLikes + 1);
        } else {
            delete allLikes[postId];
            likesCountEl.innerText = String(baseLikes);
        }
        localStorage.setItem('omr_likes', JSON.stringify(allLikes));
    });

    // Share button
    const btnShare = document.getElementById('btn-share-post');
    if (btnShare) {
        btnShare.addEventListener('click', () => {
            navigator.clipboard.writeText(window.location.href).then(() => {
                alert('文章链接已成功复制到剪贴板！快分享给小伙伴吧 🚀');
            }).catch(() => {
                alert('链接复制失败，请手动复制当前浏览器地址栏。');
            });
        });
    }

    // Initialize Waline
    initWaline();

    // Check reply-to-view lock status
    checkReplyToView();
}

function checkUserInComments(comments: any[], nick: string): boolean {
    for (const c of comments) {
        if (c.nick === nick) return true;
        if (c.children && c.children.length > 0) {
            if (checkUserInComments(c.children, nick)) return true;
        }
    }
    return false;
}

function checkReplyToView() {
    const lockedElements = document.querySelectorAll('.reply-to-view');
    if (lockedElements.length === 0) return;

    const path = window.location.pathname;
    const storageKey = 'unlocked_' + path;

    // 1. Check if already unlocked in this session
    if (sessionStorage.getItem(storageKey) === 'true') {
        lockedElements.forEach(el => el.setAttribute('data-locked', 'false'));
        return;
    }

    // 2. Check local nickname
    const walineNick = localStorage.getItem('waline:nick');
    if (!walineNick) return;

    // 3. Fetch Waline comments to verify
    const serverURL = import.meta.env.PUBLIC_WALINE_SERVER || 'https://waline-284868.vercel.app';
    const apiURL = `${serverURL}/api/comment?path=${encodeURIComponent(path)}`;

    fetch(apiURL)
        .then(res => res.json())
        .then(json => {
            if (json.errno === 0 && json.data && json.data.data) {
                const comments = json.data.data;
                const hasCommented = checkUserInComments(comments, walineNick);
                if (hasCommented) {
                    sessionStorage.setItem(storageKey, 'true');
                    lockedElements.forEach(el => el.setAttribute('data-locked', 'false'));
                }
            }
        })
        .catch(err => console.error('Error checking comments:', err));
}

function initWaline() {
    const walineEl = document.getElementById('waline');
    if (!walineEl) return;

    const path = walineEl.getAttribute('data-path') || window.location.pathname;
    const serverURL = import.meta.env.PUBLIC_WALINE_SERVER || 'https://waline-284868.vercel.app';

    init({
        el: '#waline',
        serverURL: serverURL,
        path: path,
        dark: 'html[data-theme="dark"]',
        comment: true,
        pageview: true,
    });
}

document.addEventListener('DOMContentLoaded', initPostDetail);
document.addEventListener('astro:after-swap', initPostDetail);
</script>

<style is:global>
/* Reply-to-view locked block styles */
.reply-to-view[data-locked="true"] {
    background: var(--bg-card) !important;
    border: 2px dashed var(--accent) !important;
    border-radius: var(--radius-md) !important;
    padding: 1.5rem !important;
    text-align: center !important;
    position: relative !important;
    overflow: hidden !important;
    margin: 1.5rem 0 !important;
}
.reply-to-view[data-locked="true"]::before {
    content: "🔒" !important;
    font-size: 2rem !important;
    display: block !important;
    margin-bottom: 0.5rem !important;
}
.reply-to-view[data-locked="true"] > * {
    display: none !important;
}
.reply-to-view[data-locked="true"]::after {
    content: "💡 此处下载链接已隐藏，请在下方评论区发表回复（填写昵称和邮箱提交评论）后，重新刷新网页即可查看！" !important;
    font-weight: 700 !important;
    font-size: 0.95rem !important;
    color: var(--text-main) !important;
    display: block !important;
    line-height: 1.6 !important;
}

/* Reply-to-view unlocked block styles */
.reply-to-view[data-locked="false"] {
    border: 2px solid var(--primary-medium) !important;
    background: var(--bg-card) !important;
    border-radius: var(--radius-md) !important;
    padding: 1.5rem !important;
    margin: 1.5rem 0 !important;
}
.reply-to-view[data-locked="false"]::before {
    content: "🔑 已解锁下载内容" !important;
    font-size: 1.1rem !important;
    font-weight: 800 !important;
    color: var(--primary) !important;
    display: block !important;
    margin-bottom: 0.75rem !important;
    border-bottom: 1px solid var(--border) !important;
    padding-bottom: 0.5rem !important;
    text-align: left !important;
}
.reply-to-view[data-locked="false"] > * {
    display: block !important;
}
</style>
