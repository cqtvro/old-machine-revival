---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout
    title="复活日记 | Daphile 教程、旧电脑改造与 Hi-Fi 避坑"
    description="系统整理老机复活全部文章：Daphile 安装与调优、二手 DAC 选购、HP T620 数播、旧电脑升级、线材和线性电源反玄学避坑。"
    currentPath="/blog"
>
    <section id="blog-view" class="page-view">
        <div class="section-container">
            <div class="view-header">
                <div>
                    <h1 class="view-title">复活日记</h1>
                    <p class="view-subtitle">用详实的步骤和生动的手记，记录每一个设备获得新生的过程。</p>
                </div>
                <div class="blog-filters-container">
                    <div class="search-box">
                        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <input type="text" id="blog-search" placeholder="搜索文章标题或内容...">
                    </div>
                </div>
            </div>

            <!-- ====== Daphile Series Roadmap Module ====== -->
            <div class="series-roadmap" id="daphile-roadmap">
                <div class="roadmap-header">
                    <div class="roadmap-badge">📡 系列专题</div>
                    <h2 class="roadmap-title">Daphile 数播完全指南</h2>
                    <p class="roadmap-subtitle">从零基础到内核级调优，10 篇文章带你搭建一套吊打五千块商业数播的 Hi-Fi 系统</p>
                </div>

                <!-- Tier 1: 入门篇 -->
                <div class="roadmap-tier">
                    <div class="tier-label">
                        <span class="tier-icon">🌱</span>
                        <span class="tier-name">入门篇</span>
                        <span class="tier-desc">从零开始，6步搞定</span>
                    </div>
                    <div class="roadmap-timeline">
                        <a href="/blog/daphile-introduction" class="roadmap-step">
                            <span class="step-number">1</span>
                            <span class="step-label">系统介绍<br/><small>硬件准备</small></span>
                        </a>
                        <div class="step-connector"></div>
                        <a href="/blog/daphile-installation" class="roadmap-step">
                            <span class="step-number">2</span>
                            <span class="step-label">系统安装<br/><small>U盘3分钟</small></span>
                        </a>
                        <div class="step-connector"></div>
                        <a href="/blog/daphile-music-transfer" class="roadmap-step">
                            <span class="step-number">3</span>
                            <span class="step-label">导入音乐<br/><small>网络共享</small></span>
                        </a>
                        <div class="step-connector"></div>
                        <a href="/blog/daphile-decoder" class="roadmap-step">
                            <span class="step-number">4</span>
                            <span class="step-label">解码设置<br/><small>音质起飞</small></span>
                        </a>
                        <div class="step-connector"></div>
                        <a href="/blog/daphile-decoder-buying-guide" class="roadmap-step step-bonus">
                            <span class="step-number">★</span>
                            <span class="step-label">选购避坑<br/><small>闲鱼300元</small></span>
                        </a>
                        <div class="step-connector"></div>
                        <a href="/blog/daphile-final-setup" class="roadmap-step step-finale">
                            <span class="step-number">✓</span>
                            <span class="step-label">大结局<br/><small>几十块搞定</small></span>
                        </a>
                    </div>
                </div>

                <!-- Tier 2: 进阶篇 -->
                <div class="roadmap-tier tier-advanced">
                    <div class="tier-label">
                        <span class="tier-icon">🔥</span>
                        <span class="tier-name">进阶篇</span>
                        <span class="tier-desc">压榨性能，极致听感</span>
                    </div>
                    <div class="roadmap-timeline">
                        <a href="/blog/fnos-daphile-vm" class="roadmap-step">
                            <span class="step-number">7</span>
                            <span class="step-label">NAS虚拟机<br/><small>飞牛直通</small></span>
                        </a>
                        <div class="step-connector"></div>
                        <a href="/blog/dual-daphile-setup" class="roadmap-step">
                            <span class="step-number">8</span>
                            <span class="step-label">双达菲架构<br/><small>物理隔离</small></span>
                        </a>
                        <div class="step-connector"></div>
                        <a href="/blog/daphile-kernel-tuning" class="roadmap-step">
                            <span class="step-number">9</span>
                            <span class="step-label">内核调优<br/><small>RAM+CPU+NFS</small></span>
                        </a>
                        <div class="step-connector"></div>
                        <a href="/blog/ai-fir-filter" class="roadmap-step step-finale">
                            <span class="step-number">10</span>
                            <span class="step-label">AI调音<br/><small>FIR滤波器</small></span>
                        </a>
                    </div>
                </div>

                <div class="roadmap-cta">
                    <span class="roadmap-cta-text">💡 建议从第 1 步开始，按顺序阅读效果最佳</span>
                </div>
            </div>

            <!-- Category Filters -->
            <div class="categories-bar">
                <button class="category-btn active" data-category="all">全部文章</button>
                <button class="category-btn" data-category="notebook">笔记本</button>
                <button class="category-btn" data-category="desktop">台式机/服务器</button>
                <button class="category-btn" data-category="system">系统/优化</button>
                <button class="category-btn" data-category="audio">音响发烧</button>
                <button class="category-btn" data-category="daphile">数播教程</button>
                <button class="category-btn" data-category="others">其他改造</button>
            </div>

            <!-- Articles Grid -->
            <div id="posts-grid" class="posts-grid">
                {sortedPosts.map(post => (
                    <PostCard
                        slug={post.slug}
                        title={post.data.title}
                        summary={post.data.summary}
                        category={post.data.category}
                        categoryName={post.data.categoryName}
                        date={post.data.date}
                        likes={post.data.likes}
                        bannerGradient={post.data.bannerGradient}
                        tags={post.data.tags}
                    />
                ))}
            </div>

            <!-- Empty State -->
            <div id="search-empty-state" class="empty-state" style="display: none;">
                <div class="empty-icon">📂</div>
                <h3>没有找到相关文章</h3>
                <p>试试其他关键词，或者随便看看吧！</p>
                <button id="btn-clear-search" class="btn btn-secondary">清除搜索</button>
            </div>
        </div>
    </section>
</Layout>

<script>
function initBlogFilters() {
    const searchInput = document.getElementById('blog-search') as HTMLInputElement;
    const postsGrid = document.getElementById('posts-grid');
    const emptyState = document.getElementById('search-empty-state');
    const categoryBtns = document.querySelectorAll('.category-btn');
    const clearBtn = document.getElementById('btn-clear-search');

    if (!postsGrid) return;
    const allCards = Array.from(postsGrid.querySelectorAll('.post-card')) as HTMLElement[];

    function filterPosts() {
        const query = searchInput?.value.trim().toLowerCase() || '';
        const activeCat = document.querySelector('.category-btn.active')?.getAttribute('data-category') || 'all';
        let visibleCount = 0;

        allCards.forEach(card => {
            const category = card.getAttribute('data-category') || '';
            const title = card.getAttribute('data-title') || '';
            const summary = card.getAttribute('data-summary') || '';
            const tags = card.getAttribute('data-tags') || '';

            const matchesCat = activeCat === 'all' || category === activeCat;
            const matchesSearch = !query || title.includes(query) || summary.includes(query) || tags.includes(query);

            if (matchesCat && matchesSearch) {
                card.style.display = '';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        if (emptyState) {
            emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
        }
    }

    if (searchInput) {
        searchInput.addEventListener('input', filterPosts);
    }

    categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            categoryBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            filterPosts();
        });
    });

    if (clearBtn && searchInput) {
        clearBtn.addEventListener('click', () => {
            searchInput.value = '';
            filterPosts();
        });
    }

    // Check URL parameters for category filtering on page load
    const urlParams = new URLSearchParams(window.location.search);
    const categoryParam = urlParams.get('category');
    if (categoryParam) {
        let found = false;
        categoryBtns.forEach(btn => {
            if (btn.getAttribute('data-category') === categoryParam) {
                categoryBtns.forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                found = true;
            }
        });
        if (found) {
            filterPosts();
            // Wait a brief moment or do it directly to scroll down to categories bar
            setTimeout(() => {
                const categoriesBar = document.querySelector('.categories-bar');
                if (categoriesBar) {
                    categoriesBar.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }, 100);
        }
    }
}

document.addEventListener('DOMContentLoaded', initBlogFilters);
</script>
