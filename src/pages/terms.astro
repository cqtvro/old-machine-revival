---
import Layout from '../layouts/Layout.astro';
---

<Layout title="免责声明与服务条款 | 老机复活" description="老机复活博客小站的免责声明与服务条款，包括硬件改造风险提示、内容版权说明和用户行为规范。" currentPath="/terms">
