---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import ProfileCard from '../components/ProfileCard.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const featuredPosts = sortedPosts.slice(0, 4);
---

<Layout
    title="老机复活 | Daphile 数播教程、旧电脑改造与 Hi-Fi 反玄学"
    description="老机复活专注 Daphile 数播教程、旧电脑/洋垃圾硬件改造、低成本 Hi-Fi 方案与音响反玄学实测，用数据和折腾经验帮你少交智商税。"
    currentPath="/"
>
    <section id="home-view" class="page-view home-page-v2">
        <!-- Compact Hero Section -->
        <div class="section-container compact-hero-container">
            <div class="compact-hero">
                <div class="hero-content">
                    <span class="hero-badge">💿 Daphile 数播 / 旧电脑复活 / Hi-Fi 反玄学</span>
                    <h1 class="hero-title">旧电脑，改成 Daphile 数播和低成本 Hi-Fi 系统</h1>
                    <p class="hero-desc">
                        这里记录 Daphile 安装调优、二手 DAC 选购、洋垃圾硬件改造和音响反玄学实测。用数据和实战经验，帮你少花钱、少踩坑，把闲置设备变成真正有用的东西。
                    </p>
                    <div class="hero-buttons">
                        <a href="/blog#daphile-roadmap" class="btn btn-primary">开始 Daphile 路线 &rarr;</a>
                        <a href="/blog?category=audio" class="btn btn-secondary">看反玄学实测</a>
                    </div>
                    <div class="hero-extra-link-row">
                        <a href="/blog/daphile-decoder-buying-guide" class="hero-text-link">二手 DAC 怎么选？&rarr;</a>
                    </div>
                </div>
                <div class="hero-entry-panel">
                    <h3>热门专题入口</h3>
                    <ul class="hero-entry-list">
                        <li>
                            <a href="/blog#daphile-roadmap">
                                <span class="entry-icon">💿</span>
                                <div class="entry-text">
                                    <strong>Daphile 数播完全指南</strong>
                                    <p>从 U 盘安装到双达菲、内核调优</p>
                                </div>
                                <span class="entry-arrow">&rarr;</span>
                            </a>
                        </li>
                        <li>
                            <a href="/blog?category=audio">
                                <span class="entry-icon">🔊</span>
                                <div class="entry-text">
                                    <strong>Hi-Fi 反玄学实测</strong>
                                    <p>线材、线电、数播智商税避坑</p>
                                </div>
                                <span class="entry-arrow">&rarr;</span>
                            </a>
                        </li>
                        <li>
                            <a href="/blog/daphile-decoder-buying-guide">
                                <span class="entry-icon">🔌</span>
                                <div class="entry-text">
                                    <strong>300 元 DAC 选购指南</strong>
                                    <p>小尾巴、桌面解码器、闲鱼避坑</p>
                                </div>
                                <span class="entry-arrow">&rarr;</span>
                            </a>
                        </li>
                        <li>
                            <a href="/blog?category=system">
                                <span class="entry-icon">💻</span>
                                <div class="entry-text">
                                    <strong>旧电脑复活指南</strong>
                                    <p>SSD、Linux、NAS、软路由</p>
                                </div>
                                <span class="entry-arrow">&rarr;</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Quick Routes Section -->
        <div class="section-container quick-routes-section">
            <div class="quick-routes">
                <!-- Route Card 1 -->
                <a href="/blog#daphile-roadmap" class="route-card">
                    <div class="route-card-header">
                        <span class="route-badge badge-daphile">📡 Daphile 数播</span>
                    </div>
                    <h3>Daphile 数播路线</h3>
                    <p class="route-desc">适合：想用旧电脑/瘦客户机做播放器</p>
                    <div class="route-chips">
                        <span class="chip">数播安装</span>
                        <span class="chip">双达菲</span>
                        <span class="chip">内核调优</span>
                    </div>
                    <span class="route-link">开始探索 &rarr;</span>
                </a>
                <!-- Route Card 2 -->
                <a href="/blog?category=audio" class="route-card">
                    <div class="route-card-header">
                        <span class="route-badge badge-audio">🔊 反玄学</span>
                    </div>
                    <h3>Hi-Fi 反玄学路线</h3>
                    <p class="route-desc">适合：想避开线材、线电、数播智商税</p>
                    <div class="route-chips">
                        <span class="chip">线材真相</span>
                        <span class="chip">线性电源</span>
                        <span class="chip">避坑指南</span>
                    </div>
                    <span class="route-link">看避坑实测 &rarr;</span>
                </a>
                <!-- Route Card 3 -->
                <a href="/blog/daphile-decoder-buying-guide" class="route-card">
                    <div class="route-card-header">
                        <span class="route-badge badge-dac">🔌 低成本</span>
                    </div>
                    <h3>低成本选购路线</h3>
                    <p class="route-desc">适合：想买二手 DAC、小尾巴、洋垃圾硬件</p>
                    <div class="route-chips">
                        <span class="chip">闲鱼避坑</span>
                        <span class="chip">300元解码</span>
                        <span class="chip">老旧硬件</span>
                    </div>
                    <span class="route-link">去选购指南 &rarr;</span>
                </a>
            </div>
        </div>

        <!-- Featured Articles Section -->
        <div class="section-container featured-articles-section">
            <div class="column-header">
                <h2 class="sub-section-title">最新折腾记录</h2>
                <a href="/blog" class="link-more">查看全部文章 &rarr;</a>
            </div>
            <div class="posts-grid home-posts-grid">
                {featuredPosts.map(post => (
                    <PostCard
                        slug={post.slug}
                        title={post.data.title}
                        summary={post.data.summary}
                        category={post.data.category}
                        categoryName={post.data.categoryName}
                        date={post.data.date}
                        likes={post.data.likes}
                        bannerGradient={post.data.bannerGradient}
                        tags={post.data.tags}
                    />
                ))}
            </div>
        </div>

        <!-- Tool Strip -->
        <div class="tool-strip-section">
            <div class="section-container">
                <div class="tool-strip">
                    <div class="tool-strip-content">
                        <span class="tool-strip-icon">🛠️</span>
                        <p class="tool-strip-text">
                            <strong>不知道你的老机器还能干什么？</strong>
                            <span>输入 CPU / 内存 / 硬盘类型，生成升级建议和适用系统。</span>
                        </p>
                    </div>
                    <a href="#calculator-anchor" class="btn btn-primary btn-sm btn-tool-strip">打开配置诊断</a>
                </div>
            </div>
        </div>

        <!-- Topic Grid Section -->
        <div class="section-container topic-grid-section">
            <div class="section-header text-center">
                <h2 class="section-title">折腾专题专栏</h2>
                <p class="section-subtitle">按主题快速检索，精准击破痛点</p>
            </div>
            <div class="topic-mini-grid">
                <a href="/blog?category=daphile" class="topic-mini-card">
                    <span class="topic-icon bg-orange-light">📀</span>
                    <div class="topic-info">
                        <h3>Daphile 教程</h3>
                        <p>数播系统安装与进阶调优</p>
                    </div>
                </a>
                <a href="/blog/daphile-decoder-buying-guide" class="topic-mini-card">
                    <span class="topic-icon bg-blue-light">🔌</span>
                    <div class="topic-info">
                        <h3>二手 DAC</h3>
                        <p>解码器避坑与300元高性价比选购</p>
                    </div>
                </a>
                <a href="/blog?category=audio" class="topic-mini-card">
                    <span class="topic-icon bg-red-light">🔊</span>
                    <div class="topic-info">
                        <h3>反玄学实测</h3>
                        <p>揭露发烧线材与电源避坑指南</p>
                    </div>
                </a>
                <a href="/blog?category=notebook" class="topic-mini-card">
                    <span class="topic-icon bg-green-light">💻</span>
                    <div class="topic-info">
                        <h3>旧笔记本</h3>
                        <p>清灰保养、硬件升级与系统复活</p>
                    </div>
                </a>
                <a href="/blog?category=desktop" class="topic-mini-card">
                    <span class="topic-icon bg-purple-light">🖥️</span>
                    <div class="topic-info">
                        <h3>NAS / 服务器</h3>
                        <p>软路由、轻量NAS与家用服务器搭建</p>
                    </div>
                </a>
                <a href="/blog?category=system" class="topic-mini-card">
                    <span class="topic-icon bg-teal-light">⚙️</span>
                    <div class="topic-info">
                        <h3>系统优化</h3>
                        <p>极简 Linux 方案与系统内核调优</p>
                    </div>
                </a>
            </div>
        </div>

        <!-- Calculator Section -->
        <div class="section-container calculator-section" id="calculator-anchor">
            <div class="calculator-wrapper">
                <Calculator />
            </div>
        </div>

        <!-- Footer Profile Intro -->
        <div class="homepage-footer-profile">
            <div class="section-container text-center">
                <p class="profile-intro-text">
                    由 <strong>七木</strong> 维护，专注低成本硬件改造、Daphile 数播完全指南与 Hi-Fi 反玄学实测。
                </p>
                <a href="/about" class="profile-more-link">了解更多关于本站 &rarr;</a>
            </div>
        </div>
    </section>
</Layout>
