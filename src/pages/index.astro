---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import ProfileCard from '../components/ProfileCard.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const featuredPosts = sortedPosts.slice(0, 4);
---

<Layout
    title="老机复活 | Daphile 数播教程、旧电脑改造与 Hi-Fi 反玄学"
    description="老机复活专注 Daphile 数播教程、旧电脑/洋垃圾硬件改造、低成本 Hi-Fi 方案与音响反玄学实测，用数据和折腾经验帮你少交智商税。"
    currentPath="/"
>
    <section id="home-view" class="page-view">
        <!-- Hero Banner -->
        <div class="hero-section">
            <div class="hero-content">
                <span class="hero-badge">🌱 让闲置硬件再次起舞</span>
                <h1 class="hero-title">拯救旧设备，重启新可能</h1>
                <p class="hero-desc">
                    在这个不断催促我们更新换代的时代，我们选择慢下来。一台十年前的笔记本、一部吃灰的主机，只需要适当的维护、合理的升级与轻量化的系统，就能在新的领域重新焕发光彩。这是属于折腾者的浪漫，也是送给地球的一份微薄礼物。
                </p>
                <div class="hero-buttons">
                    <a href="/blog" class="btn btn-primary">探索复活案例</a>
                    <a href="#calculator-anchor" class="btn btn-secondary">配置诊断工具</a>
                </div>
            </div>
            <div class="hero-visual">
                <div class="retro-machine-artwork">
                    <div class="monitor-wrapper">
                        <div class="screen-glow"></div>
                        <div class="monitor-frame">
                            <div class="monitor-screen">
                                <div class="terminal-text">
                                    <p>&gt; sudo apt update</p>
                                    <p>&gt; Upgrading hardware...</p>
                                    <p>&gt; System status: OK</p>
                                    <p class="blink-cursor">&gt; 🌱 Ready to revive!</p>
                                </div>
                            </div>
                        </div>
                        <div class="monitor-neck"></div>
                        <div class="monitor-base"></div>
                    </div>
                    <div class="floating-elements">
                        <div class="floating-item item-ram">📼 RAM</div>
                        <div class="floating-item item-ssd">💾 SSD</div>
                        <div class="floating-item item-tux">🐧 Linux</div>
                        <div class="floating-item item-leaf">🍃 CPU</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Categories Portal -->
        <div class="section-container categories-portal-section">
            <div class="portal-header text-center">
                <h2 class="section-title">折腾专题专栏</h2>
                <p class="section-subtitle">按主题快速检索，精准击破痛点</p>
            </div>
            <div class="categories-portal-grid">
                <a href="/blog?category=notebook" class="portal-card">
                    <div class="portal-icon bg-green-light">💻</div>
                    <h3>笔记本复活</h3>
                    <p>清理保养、升级固态硬盘与轻量 Linux 系统定制，让闲置笔记本重现丝滑。</p>
                    <span class="portal-link">浏览专栏 &rarr;</span>
                </a>
                <a href="/blog?category=desktop" class="portal-card">
                    <div class="portal-icon bg-blue-light">🖥️</div>
                    <h3>台式机/服务器</h3>
                    <p>旧电脑、软路由与洋垃圾硬件搭建家用轻量级 NAS、媒体服务器场景再造。</p>
                    <span class="portal-link">浏览专栏 &rarr;</span>
                </a>
                <a href="/blog?category=daphile" class="portal-card">
                    <div class="portal-icon bg-orange-light">📀</div>
                    <h3>Daphile 数播</h3>
                    <p>低成本搭建 Daphile 高保真音乐播放系统，包含双达菲与内核级性能调优。</p>
                    <span class="portal-link">浏览专栏 &rarr;</span>
                </a>
                <a href="/blog?category=audio" class="portal-card">
                    <div class="portal-icon bg-red-light">🔊</div>
                    <h3>音响与反玄学</h3>
                    <p>用客观数据和对比实测说话，揭露高端线材与电源避坑玄学，理性发烧。</p>
                    <span class="portal-link">浏览专栏 &rarr;</span>
                </a>
            </div>
        </div>

        <!-- Home Content Layout -->
        <div class="section-container home-layout">
            <div class="main-column">
                <div class="column-header">
                    <h2 class="sub-section-title">精选复活案例</h2>
                    <a href="/blog" class="link-more">查看全部文章 &rarr;</a>
                </div>
                <div class="posts-grid home-posts-grid">
                    {featuredPosts.map(post => (
                        <PostCard
                            slug={post.slug}
                            title={post.data.title}
                            summary={post.data.summary}
                            category={post.data.category}
                            categoryName={post.data.categoryName}
                            date={post.data.date}
                            likes={post.data.likes}
                            bannerGradient={post.data.bannerGradient}
                            tags={post.data.tags}
                        />
                    ))}
                </div>
            </div>

            <aside class="sidebar-column">
                <!-- Daphile Series Roadmap Guide Widget -->
                <div class="widget-card daphile-widget-card">
                    <div class="widget-header">
                        <span class="widget-icon">📡</span>
                        <h3>Daphile 数播完全指南</h3>
                    </div>
                    <p class="widget-intro">
                        从零基础系统安装，到双达菲隔离架构与内核级性能调优。手把手带你用废旧电脑/洋垃圾搭建高保真 Hi-Fi 播放系统！
                    </p>
                    <ul class="widget-checklist">
                        <li><span>🌱</span> <span><strong>入门：</strong>U盘安装与解码设置</span></li>
                        <li><span>🔥</span> <span><strong>进阶：</strong>双达菲架构与内核调优</span></li>
                        <li><span>🎵</span> <span><strong>调音：</strong>AI 滤波器与 FIR 降噪</span></li>
                    </ul>
                    <a href="/blog#daphile-roadmap" class="btn btn-primary btn-block">
                        开启发烧之路 &rarr;
                    </a>
                </div>

                <div id="calculator-anchor"></div>
                <Calculator />
                <ProfileCard postCount={allPosts.length} />
            </aside>
        </div>
    </section>
</Layout>
