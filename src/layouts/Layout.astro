---
import ContactWidget from '../components/ContactWidget.astro';

interface Props {
    title?: string;
    description?: string;
    currentPath?: string;
    type?: 'website' | 'article';
    structuredData?: Record<string, unknown> | Record<string, unknown>[];
    noindex?: boolean;
}

const {
    title = '老机复活 | 让旧设备重新绽放光芒',
    description = '老机复活是一个专注于旧电脑、旧手机、老游戏机等硬件的清理、升级、改装与轻量级系统优化的个人博客。用爱与技术赋予老硬件新的生命。',
    currentPath = '/',
    type = 'website',
    structuredData,
    noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://www.284868.xyz');
const canonicalPath = currentPath === '/' || currentPath.endsWith('/') || currentPath.includes('.')
    ? currentPath
    : `${currentPath}/`;
const canonicalUrl = new URL(canonicalPath, site).toString();
const defaultStructuredData = {
    '@context': 'https://schema.org',
    '@graph': [
        {
            '@type': 'WebSite',
            name: '老机复活',
            url: new URL('/', site).toString(),
            description,
            inLanguage: 'zh-CN',
        },
        {
            '@type': 'Organization',
            name: '老机复活',
            url: new URL('/', site).toString(),
        },
    ],
};
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex,follow">}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="canonical" href={canonicalUrl}>
    <link rel="alternate" type="application/rss+xml" title="老机复活 RSS" href={new URL('/rss.xml', site).toString()}>
    <meta property="og:site_name" content="老机复活">
    <meta property="og:locale" content="zh_CN">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content={type}>
    <meta property="og:url" content={canonicalUrl}>
    <meta name="twitter:card" content="summary">
    <script type="application/ld+json" set:html={JSON.stringify(structuredData ?? defaultStructuredData)} />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Noto+Sans+SC:wght@300;400;500;700;900&display=swap" rel="stylesheet">

    <!-- Inline theme init to prevent FOUC (flash of unstyled content) -->
    <script is:inline>
        (function() {
            var theme = localStorage.getItem('omr_theme');
            if (!theme) {
                theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            if (theme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
</head>
<body>
    <!-- Top Progress Bar -->
    <div id="page-progress" class="page-progress"></div>

    <!-- Globally Exclusive Feature Banner -->
    <div class="global-announcement-banner">
        <div class="announcement-content">
            <span class="announcement-fire-icon">🔥</span>
            <span class="announcement-text">
                <strong>全球首创 / 独家发布</strong>：全网唯一支持 Daphile (达菲) <strong>直接播放 SACD-ISO 镜像</strong> 的智能汉化写盘方案，免解压、源码直出！
            </span>
            <a href="/blog/daphile-v320-release" class="announcement-link">立即下载体验 &rarr;</a>
        </div>
    </div>

    <!-- Header & Navigation -->
    <header class="site-header">
        <div class="header-container">
            <a href="/" class="logo" id="logo-link">
                <svg viewBox="0 0 100 100" class="logo-svg" aria-hidden="true">
                    <rect x="15" y="15" width="70" height="50" rx="10" fill="none" stroke="currentColor" stroke-width="6" />
                    <line x1="25" y1="50" x2="75" y2="50" stroke="currentColor" stroke-dasharray="2,2" stroke-width="2" />
                    <path d="M35,65 L25,85 L75,85 L65,65 Z" fill="none" stroke="currentColor" stroke-width="6" stroke-linejoin="round" />
                    <path d="M50,45 C50,30 35,25 35,25 C35,25 45,35 50,45 Z" fill="currentColor" />
                    <path d="M50,45 C50,30 65,25 65,25 C65,25 55,35 50,45 Z" fill="currentColor" />
                    <circle cx="50" cy="45" r="3" fill="currentColor" />
                </svg>
                <div class="logo-text">
                    <span class="brand-title">老机复活</span>
                    <span class="brand-subtitle">Old Machine Revival</span>
                </div>
            </a>

            <!-- Desktop Navigation -->
            <!-- Desktop Navigation -->
            <nav class="desktop-nav" aria-label="主导航">
                <ul>
                    <li><a href="/" class:list={["nav-item", { active: currentPath === '/' }]} id="nav-home">首页</a></li>
                    <li><a href="/blog" class:list={["nav-item", { active: currentPath.startsWith('/blog') }]} id="nav-blog">精选博客</a></li>
                    <li><a href="/bbs" class:list={["nav-item", { active: currentPath.startsWith('/bbs') }]} id="nav-bbs">社区论坛</a></li>
                    <li><a href="/about" class:list={["nav-item", { active: currentPath === '/about' }]} id="nav-about">关于本站</a></li>
                </ul>
            </nav>

            <!-- Theme Toggle & Action -->
            <div class="header-actions">
                <button id="theme-toggle" class="theme-toggle-btn" aria-label="切换深色模式">
                    <svg class="icon moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                    <svg class="icon sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                </button>
                <a href="#contact" class="contact-shortcut-btn" data-trigger-contact>微信咨询</a>
                <a href="/#calculator-anchor" class="calc-shortcut-btn">复活指南</a>
            </div>

            <!-- Mobile Hamburger -->
            <button class="mobile-nav-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="菜单">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </header>

    <!-- Mobile Navigation Drawer -->
    <nav class="mobile-nav-drawer" id="mobile-nav" aria-label="移动端导航" style="display: none;">
        <ul>
            <li><a href="/" class:list={["mobile-nav-item", { active: currentPath === '/' }]}>首页</a></li>
            <li><a href="/blog" class:list={["mobile-nav-item", { active: currentPath.startsWith('/blog') }]}>精选博客</a></li>
            <li><a href="/bbs" class:list={["mobile-nav-item", { active: currentPath.startsWith('/bbs') }]}>社区论坛</a></li>
            <li><a href="/about" class:list={["mobile-nav-item", { active: currentPath === '/about' }]}>关于本站</a></li>
            <li><a href="#contact" class="mobile-nav-item highlight-contact" data-trigger-contact style="color: var(--primary); font-weight: bold; border-top: 1px dashed var(--border); margin-top: 5px; padding-top: 10px;">💬 微信咨询/购买</a></li>
        </ul>
    </nav>

    <!-- Main Content -->
    <main class="main-content">
        <slot />
    </main>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="footer-container">
            <div class="footer-brand">
                <span class="footer-logo">🌱 老机复活</span>
                <p class="footer-tagline">用代码和螺丝刀，赋予陈旧硬件第二次春天。</p>
            </div>
            <div class="footer-links">
                <h4>快速链接</h4>
                <ul>
                    <li><a href="/">回到首页</a></li>
                    <li><a href="/blog">所有案例</a></li>
                    <li><a href="/bbs">社区论坛</a></li>
                    <li><a href="/about">关于小站</a></li>
                    <li><a href="/privacy">隐私政策</a></li>
                    <li><a href="/terms">免责声明</a></li>
                </ul>
            </div>
            <div class="footer-copyright">
                <p>&copy; 2026 老机复活 (Old Machine Revival). Powered by Astro &amp; Vanilla CSS.</p>
                <p class="eco-friendly-text">💚 绿化环境，理性升级，让闲置硬件发光发热。</p>
            </div>
        </div>
    </footer>

    <!-- Global Scripts -->
    <script>
        import { inject } from "@vercel/analytics";
        inject();

        // Theme Toggle
        function initTheme() {
            const themeToggle = document.getElementById('theme-toggle');
            if (!themeToggle) return;
            const moonIcon = themeToggle.querySelector('.moon-icon') as HTMLElement;
            const sunIcon = themeToggle.querySelector('.sun-icon') as HTMLElement;

            function setTheme(theme: string) {
                if (theme === 'dark') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    if (moonIcon) moonIcon.style.display = 'none';
                    if (sunIcon) sunIcon.style.display = 'block';
                } else {
                    document.documentElement.removeAttribute('data-theme');
                    if (moonIcon) moonIcon.style.display = 'block';
                    if (sunIcon) sunIcon.style.display = 'none';
                }
                localStorage.setItem('omr_theme', theme);
            }

            // Initialize icon state based on current theme
            const currentTheme = localStorage.getItem('omr_theme') ||
                (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            setTheme(currentTheme);

            themeToggle.addEventListener('click', () => {
                const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
                setTheme(isDark ? 'light' : 'dark');
            });
        }

        // Mobile Navigation
        function initMobileNav() {
            const mobileToggle = document.querySelector('.mobile-nav-toggle');
            const mobileNav = document.getElementById('mobile-nav');
            if (mobileToggle && mobileNav) {
                mobileToggle.addEventListener('click', () => {
                    const isOpen = mobileToggle.classList.toggle('open');
                    mobileToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
                    (mobileNav as HTMLElement).style.display = isOpen ? 'block' : 'none';
                });
            }
        }

        // Global Announcement Banner Scroll Adjuster
        function initBannerScroll() {
            const banner = document.querySelector('.global-announcement-banner') as HTMLElement;
            const header = document.querySelector('.site-header') as HTMLElement;
            if (!banner || !header) return;

            function handleScroll() {
                const bannerHeight = banner.offsetHeight;
                const scrollY = window.scrollY;
                
                // Dynamically set CSS variable for main content spacing
                document.documentElement.style.setProperty('--global-banner-height', `${bannerHeight}px`);
                
                if (scrollY > bannerHeight) {
                    header.style.top = '0px';
                } else {
                    header.style.top = `${bannerHeight - scrollY}px`;
                }
            }

            window.addEventListener('scroll', handleScroll, { passive: true });
            window.addEventListener('resize', handleScroll, { passive: true });
            handleScroll();
        }

        // Init on page load
        document.addEventListener('DOMContentLoaded', () => {
            initTheme();
            initMobileNav();
            initBannerScroll();
        });

        // Re-init on Astro page transitions (View Transitions)
        document.addEventListener('astro:after-swap', () => {
            initTheme();
            initMobileNav();
            initBannerScroll();
        });
    </script>
    <ContactWidget />
</body>
</html>

<style is:global>
    @import '../styles/style.css';

    /* Global Announcement Banner */
    .global-announcement-banner {
        background: linear-gradient(90deg, #ff416c 0%, #ff4b2b 100%);
        color: white;
        padding: 10px 24px;
        text-align: center;
        font-size: 0.92rem;
        box-shadow: 0 2px 8px rgba(255, 75, 43, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        position: relative;
        z-index: 1010;
        animation: pulseGradient 4s infinite alternate;
    }
    .announcement-content {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
    }
    .announcement-fire-icon {
        font-size: 1.1rem;
        display: inline-block;
        animation: scaleUpDown 1.2s infinite alternate;
    }
    .announcement-text {
        font-weight: 500;
        letter-spacing: 0.2px;
    }
    .announcement-text strong {
        font-weight: 800;
        background: rgba(255, 255, 255, 0.25);
        padding: 1px 5px;
        border-radius: 3px;
        margin: 0 2px;
    }
    .announcement-link {
        color: #fff;
        text-decoration: underline;
        font-weight: 700;
        margin-left: 2px;
        transition: opacity 0.2s ease;
    }
    .announcement-link:hover {
        opacity: 0.9;
        text-decoration: none;
    }
    @keyframes pulseGradient {
        0% {
            filter: hue-rotate(0deg);
        }
        100% {
            filter: hue-rotate(15deg);
        }
    }
    @keyframes scaleUpDown {
        0% { transform: scale(1); }
        100% { transform: scale(1.22); }
    }
    
    /* Dynamically adjust main content spacing below fixed header + banner */
    .main-content {
        margin-top: calc(var(--header-height) + var(--global-banner-height, 42px)) !important;
    }

    @media (max-width: 768px) {
        .global-announcement-banner {
            padding: 8px 16px;
            font-size: 0.82rem;
        }
        .announcement-content {
            gap: 4px;
        }
    }
</style>
