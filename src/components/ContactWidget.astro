---
// ContactWidget.astro - Global floating WeChat & Email contact widget
---

<div class="contact-widget-container" id="contact-widget">
    <!-- Floating Trigger Button -->
    <button class="contact-trigger-btn" id="contact-trigger" aria-label="联系站长/购买咨询" title="联系站长/购买咨询">
        <span class="pulse-ring"></span>
        <svg class="icon-chat" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
        </svg>
        <span class="trigger-text">微信咨询</span>
    </button>

    <!-- Dialog Panel -->
    <div class="contact-panel" id="contact-panel" style="display: none;">
        <div class="panel-header">
            <div class="panel-title-area">
                <span class="badge-online">● 快速响应</span>
                <h3>购买咨询与技术支持</h3>
            </div>
            <button class="panel-close-btn" id="contact-close" aria-label="关闭面板">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="panel-body">
            <p class="panel-desc">选购 <strong>Daphile v3.2.0 专享系统授权 / 实体 U 盘</strong>，或有任何安装调试疑问，请添加站长微信直接沟通。</p>
            
            <!-- WeChat Card -->
            <div class="contact-card wechat-card">
                <div class="card-info">
                    <span class="card-label">站长微信号</span>
                    <div class="wechat-id-row">
                        <code class="wechat-id" id="wechat-id-text">wxcq888</code>
                        <button class="btn-copy" id="btn-copy-wechat" data-clipboard-text="wxcq888">
                            <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                            </svg>
                            <span class="copy-btn-text">复制</span>
                        </button>
                    </div>
                </div>

                <!-- QR Code Container -->
                <div class="qr-container">
                    <!-- Try loading actual QR code image -->
                    <img 
                        src="/images/contact-qr.png" 
                        alt="微信二维码" 
                        class="qr-img" 
                        id="contact-qr-img"
                        onerror="this.style.display='none'; document.getElementById('qr-placeholder').style.display='flex';"
                    />
                    <!-- Beautiful Fallback SVG Placeholder if image does not exist -->
                    <div class="qr-placeholder" id="qr-placeholder" style="display: none;">
                        <svg viewBox="0 0 100 100" class="placeholder-svg">
                            <rect x="5" y="5" width="90" height="90" rx="10" fill="none" stroke="var(--primary-medium)" stroke-width="2" stroke-dasharray="6,6"/>
                            <!-- A mockup QR pattern -->
                            <rect x="20" y="20" width="20" height="20" fill="var(--primary)" rx="2"/>
                            <rect x="25" y="25" width="10" height="10" fill="var(--bg-card)"/>
                            <rect x="60" y="20" width="20" height="20" fill="var(--primary)" rx="2"/>
                            <rect x="65" y="25" width="10" height="10" fill="var(--bg-card)"/>
                            <rect x="20" y="60" width="20" height="20" fill="var(--primary)" rx="2"/>
                            <rect x="25" y="65" width="10" height="10" fill="var(--bg-card)"/>
                            <!-- Small dots -->
                            <rect x="50" y="30" width="6" height="6" fill="var(--primary)" rx="1"/>
                            <rect x="50" y="45" width="6" height="6" fill="var(--accent)" rx="1"/>
                            <rect x="35" y="50" width="6" height="6" fill="var(--primary)" rx="1"/>
                            <rect x="60" y="50" width="6" height="6" fill="var(--primary)" rx="1"/>
                            <rect x="60" y="65" width="6" height="6" fill="var(--primary)" rx="1"/>
                            <rect x="45" y="65" width="8" height="8" fill="var(--primary)" rx="1"/>
                        </svg>
                        <span class="placeholder-tips">微信扫码更快速</span>
                        <span class="placeholder-subtips">（请站长放置二维码到 <code>public/images/contact-qr.png</code>）</span>
                    </div>
                </div>
                <p class="qr-scan-tips">手机端可截图保存或长按识别扫码</p>
            </div>

            <!-- Email and Official Account Info -->
            <div class="other-contacts">
                <div class="contact-item">
                    <span class="contact-item-icon">📧</span>
                    <div class="contact-item-text">
                        <strong>电子邮箱</strong>
                        <a href="mailto:admin@284868.xyz">admin@284868.xyz</a>
                    </div>
                </div>
                <div class="contact-item">
                    <span class="contact-item-icon">📱</span>
                    <div class="contact-item-text">
                        <strong>公众号</strong>
                        <span>微信搜索 <strong>“老机复活”</strong></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="panel-footer">
            <span class="security-tip">🛡️ 交易与售后服务均有官方独立站保障，安全放心</span>
        </div>
    </div>
</div>

<!-- Copy Success Toast Notification -->
<div class="copy-toast" id="copy-toast" style="display: none;">
    <span class="toast-icon">✓</span>
    <span class="toast-message">微信号已复制！请打开微信添加好友</span>
</div>

<script>
    function setupContactWidget() {
        const trigger = document.getElementById('contact-trigger');
        const panel = document.getElementById('contact-panel');
        const closeBtn = document.getElementById('contact-close');
        const copyBtn = document.getElementById('btn-copy-wechat');
        const toast = document.getElementById('copy-toast');

        if (!trigger || !panel || !closeBtn) return;

        // Toggle panel
        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = panel.style.display !== 'none';
            if (isOpen) {
                closePanel();
            } else {
                openPanel();
            }
        });

        closeBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            closePanel();
        });

        // Prevent panel clicks from closing the panel
        panel.addEventListener('click', (e) => {
            e.stopPropagation();
        });

        // Close panel when clicking outside
        document.addEventListener('click', () => {
            closePanel();
        });

        function openPanel() {
            panel.style.display = 'block';
            panel.classList.add('panel-open');
            trigger.classList.add('trigger-active');
        }

        function closePanel() {
            panel.classList.remove('panel-open');
            trigger.classList.remove('trigger-active');
            // Allow exit animation before hiding
            setTimeout(() => {
                if (!trigger.classList.contains('trigger-active')) {
                    panel.style.display = 'none';
                }
            }, 200);
        }

        // Copy functionality
        if (copyBtn) {
            copyBtn.addEventListener('click', async (e) => {
                e.stopPropagation();
                const textToCopy = copyBtn.getAttribute('data-clipboard-text') || 'wxcq888';
                
                try {
                    await navigator.clipboard.writeText(textToCopy);
                    showToast();
                } catch (err) {
                    // Fallback copy method for older browsers
                    const textArea = document.createElement("textarea");
                    textArea.value = textToCopy;
                    textArea.style.position = "fixed"; // Avoid scrolling to bottom
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    try {
                        document.execCommand('copy');
                        showToast();
                    } catch (copyErr) {
                        alert("复制失败，请手动记录微信号：" + textToCopy);
                    }
                    document.body.removeChild(textArea);
                }
            });
        }

        function showToast() {
            if (!toast) return;
            toast.style.display = 'flex';
            toast.classList.add('toast-show');
            
            setTimeout(() => {
                toast.classList.remove('toast-show');
                setTimeout(() => {
                    toast.style.display = 'none';
                }, 300);
            }, 3000);
        }

        // Global function to trigger widget
        (window as any).openContactWidget = function() {
            openPanel();
            // Scroll to the widget if it's not visible
            panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        };

        // Listen for links with href="#contact" or data-trigger-contact
        document.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            const link = target.closest('a');
            if (link) {
                const href = link.getAttribute('href');
                if (href === '#contact' || link.hasAttribute('data-trigger-contact')) {
                    e.preventDefault();
                    (window as any).openContactWidget();
                }
            } else if (target.hasAttribute('data-trigger-contact')) {
                e.preventDefault();
                (window as any).openContactWidget();
            }
        });
    }

    // Run on init
    setupContactWidget();

    // Re-run on View Transitions
    document.addEventListener('astro:after-swap', setupContactWidget);
</script>
